# Copie este arquivo pra .env e preencha. O .env NUNCA vai pro GitHub (está no .gitignore).

# ---------- Gerador de imagem (escolha um: magnific-mcp, gemini ou openai) ----------
GERADOR=magnific-mcp

# Opção B — Google Gemini (Nano Banana): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview

# Opção C — OpenAI (gpt-image): https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# ---------- Hospedagem (opcional) ----------
# Sem isso, a página abre no seu computador (python3 motor/servidor.py).
# Com isso, a página de cada produto fica em $SITE_BASE/<produto>/ (precisa de PHP e FTP).
SITE_BASE=
FTP_HOST=
FTP_USER=
FTP_PASS=
FTP_PASTA=/public_html
